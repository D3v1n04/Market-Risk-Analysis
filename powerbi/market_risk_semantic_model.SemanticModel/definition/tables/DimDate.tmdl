		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Month Name' = FORMAT(DimDate[Date], "MMMM")
		lineageTag: 03f2d3fc-0a06-4e8e-87df-a3475d26a0ab
		summarizeBy: none
		sortByColumn: 'Month Number'

