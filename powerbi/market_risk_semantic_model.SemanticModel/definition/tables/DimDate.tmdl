	hierarchy 'Calendar Hierarchy'
		lineageTag: bec2e90b-76d0-4f69-9037-042bb1c3d4a0

		level Year
			lineageTag: de006d36-1c00-4b05-8e4f-0c255c6519f7
			column: Year

		level 'Month Name'
			lineageTag: 78a4667c-621a-46dd-bd41-fc01234af085
			column: 'Month Name'

		level Date
			lineageTag: b8a3d86f-9f4e-4f85-a081-ce5b94228dd5
			column: Date

		changedProperty = IsHidden

	partition DimDate = m
		mode: import
		source =
				let
				    Source = FactPortfolioDailyAnalytics,
				    #"Removed Other Columns" = Table.SelectColumns(Source, {"valuation_date"}),
				    #"Renamed Columns" = Table.RenameColumns(
				        #"Removed Other Columns",
				        {{"valuation_date", "Date"}}
				    ),
				    #"Appended Query" = Table.Combine(
				        {#"Renamed Columns", RiskRunDates_Staging}
				    ),
				    #"Observed Dates" = Table.Distinct(#"Appended Query"),
				    StartDate = List.Min(#"Observed Dates"[Date]),
				    EndDate = List.Max(#"Observed Dates"[Date]),
				    DateList = List.Dates(
				        StartDate,
				        Duration.Days(EndDate - StartDate) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				    DimDate = Table.FromList(
				        DateList,
				        Splitter.SplitByNothing(),
				        {"Date"}
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(
				        DimDate,
				        {{"Date", type date}}
				    )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
