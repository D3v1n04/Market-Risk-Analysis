table FactStressResults
	lineageTag: f5985070-27d0-4575-a48c-37287abc231d

	measure 'Stress P&L' =

			IF(
			    HASONEVALUE(FactStressResults[scenario_id]),
			    SUM(FactStressResults[stress_pnl_usd])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Risk Measures
		lineageTag: 8199725c-48e8-44a0-8c65-84dee6af1550

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Stressed NAV' =

			IF(
			    HASONEVALUE(FactStressResults[scenario_id]),
			    SUM(FactStressResults[stressed_nav_usd])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Risk Measures
		lineageTag: 22baa5b3-a265-4e39-9ffa-bb30f5f7c30e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'VaR Amount' =

			IF(
			    HASONEVALUE(FactVaR[confidence_level]),
			    SUM(FactVaR[var_amount_usd])
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Risk Measures
		lineageTag: 8504e182-558a-4cbe-83b7-511f2fc43bc6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

