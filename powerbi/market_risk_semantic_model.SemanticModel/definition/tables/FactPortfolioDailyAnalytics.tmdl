table FactPortfolioDailyAnalytics
	lineageTag: 3b85ef7f-948f-4b36-b258-ffb5d700b8bc

	measure 'Closing NAV (Latest Date)' =

			VAR LatestValuationDate =
			    MAX(FactPortfolioDailyAnalytics[valuation_date])
			RETURN
			    CALCULATE(
			        SUM(FactPortfolioDailyAnalytics[closing_nav_usd]),
			        FactPortfolioDailyAnalytics[valuation_date] = LatestValuationDate
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Portfolio Metrics
		lineageTag: ea3a7ce2-7daf-42d3-99ef-e5166dcc873e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Daily P&L' =

			SUM(FactPortfolioDailyAnalytics[daily_pnl_usd])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Portfolio Metrics
		lineageTag: ccd720ca-b406-47ce-92d5-5f7a28e49a6f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Exposure (Latest Date)' =

			VAR LatestValuationDate =
			    MAX(FactPortfolioDailyAnalytics[valuation_date])
			RETURN
			    CALCULATE(
			        SUM(FactPortfolioDailyAnalytics[gross_exposure_usd]),
			        FactPortfolioDailyAnalytics[valuation_date] = LatestValuationDate
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Portfolio Metrics
		lineageTag: fc3655d0-87f3-4e25-bce2-cf1ef8f516ad

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Daily Return' =

			IF(
			    HASONEVALUE(DimPortfolio[portfolio_id])
			        && HASONEVALUE(DimDate[Date]),
			    MAX(FactPortfolioDailyAnalytics[daily_return_ratio])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Portfolio Metrics
		lineageTag: 48e7c205-754e-4a00-ba1f-4785fd9ae043

